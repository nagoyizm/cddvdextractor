{
  "name": "dvd-audio-extractor",
  "version": "1.0.1",
  "description": "Extractor local y de alta fidelidad de pistas de audio desde CD-DA y DVD a FLAC, WAV, MP3 y AAC",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 && wait-on dist/main/main.js && electron .\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "update:unpacked": "npm run build && node scripts/updateUnpacked.js",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:installer": "npm run build && electron-builder --win nsis",
    "release": "npm run build && electron-builder --win nsis --publish always",
    "postinstall": "node scripts/ensure-ffmpeg.js",
    "start": "electron ."
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nagoyizm/cddvdextractor.git"
  },
  "homepage": "https://github.com/nagoyizm/cddvdextractor#readme",
  "keywords": [
    "audio",
    "cd",
    "dvd",
    "extractor",
    "flac",
    "wav",
    "mp3",
    "lossless"
  ],
  "author": "Audio Engineer",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
